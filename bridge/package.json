{
  "name": "stevefish-bridge",
  "version": "0.3.0",
  "private": true,
  "description": "SteveFish bridge: local WebSocket server between the How to Fish plugin and Minecraft (Mineflayer from Phase 3)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "mc": "tsx src/cli/mc.ts",
    "demo": "tsx src/cli/demo.ts",
    "clear-barriers": "tsx src/cli/clear-barriers.ts"
  },
  "dependencies": {
    "mineflayer": "^4.39.0",
    "vec3": "0.1.10",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
