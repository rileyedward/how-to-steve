<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generated by `dotnet new bepinex5plugin` (BepInEx.Templates 2.0.0-be.4), then adapted:
       game references come from $(HowToFishManaged) (set in Directory.Build.props.user) and are never copied. -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>HowToSteve.Plugin</AssemblyName>
    <BepInExPluginGuid>dev.riley.howtosteve</BepInExPluginGuid>
    <BepInExPluginName>How to Steve</BepInExPluginName>
    <Product>How to Steve</Product>
    <Description>Play as Steve inside How to Fish (local-only Minecraft bridge)</Description>
    <Version>0.1.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>HowToSteve</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <Target Name="CheckGamePaths" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(HowToFishManaged)' == '' Or !Exists('$(HowToFishManaged)\Assembly-CSharp.dll')"
           Text="HowToFishManaged is not set or wrong. Copy Directory.Build.props.user.example to Directory.Build.props.user and edit the paths." />
  </Target>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.*" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
  </ItemGroup>

  <!-- Game assemblies: compile-time only (Private=false), resolved from the local install. -->
  <ItemGroup>
    <Reference Include="UnityEngine"><HintPath>$(HowToFishManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(HowToFishManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(HowToFishManaged)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(HowToFishManaged)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.InputSystem"><HintPath>$(HowToFishManaged)\Unity.InputSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(HowToFishManaged)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(HowToFishManaged)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(HowToFishManaged)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(HowToFishManaged)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule"><HintPath>$(HowToFishManaged)\UnityEngine.UnityWebRequestModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestAudioModule"><HintPath>$(HowToFishManaged)\UnityEngine.UnityWebRequestAudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(HowToFishManaged)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(HowToFishManaged)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="FishNet.Runtime"><HintPath>$(HowToFishManaged)\FishNet.Runtime.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- `dotnet build -p:Deploy=true` copies the plugin into BepInEx\plugins\HowToSteve\. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <Error Condition="'$(BepInExDir)' == '' Or !Exists('$(BepInExDir)\core\BepInEx.dll')" Text="BepInExDir is not set or BepInEx is not installed there." />
    <MakeDir Directories="$(BepInExDir)\plugins\HowToSteve" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins\HowToSteve" />
    <Message Importance="high" Text="Deployed $(TargetFileName) to $(BepInExDir)\plugins\HowToSteve" />
  </Target>
</Project>
